# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Git & IDE
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store

# Local SQLite databases & runtime storage
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/*.db-journal
server/data/backups/
server/data/uploads/*
!server/data/uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep

# Environment secrets
.env
.env.*
server/.env
server/.env.*
client/.env
client/.env.*

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
scratch/

# Build artifacts (will be generated by multi-stage Dockerfile)
dist/
client/dist/
coverage/
